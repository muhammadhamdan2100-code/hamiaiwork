# This project requires NO environment variables to build, run, or deploy —
# every value below is optional and has a safe, working default.

# Overrides the canonical site URL used in metadata, Open Graph tags, and
# the sitemap. If unset, the app falls back to Vercel's auto-provided
# VERCEL_URL on preview/production deployments, and finally to the
# hardcoded production domain. Only set this if you're deploying to a
# custom domain outside of Vercel (Netlify, Railway, Render, self-hosted, etc).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
